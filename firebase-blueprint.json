{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Standardized schema for Nepali Family Local App citizen registered user profiles.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifiers generated by Firebase Auth."
        },
        "fullName": {
          "type": "string",
          "description": "Official full name of the citizen."
        },
        "username": {
          "type": "string",
          "description": "Unique handle/username chosen by the resident."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Primary mobile number for security check (Ncell or NTC)."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Optional email address."
        },
        "profilePhoto": {
          "type": "string",
          "description": "HTTPS URL of stored profile picture."
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "other", "prefer_not_to_say"],
          "description": "Gender identity of the citizen."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Resident date of birth."
        },
        "province": {
          "type": "string",
          "description": "One of the 7 official provinces of Nepal (e.g. Gandaki Province)."
        },
        "district": {
          "type": "string",
          "description": "One of the 77 official districts of Nepal (e.g. Kaski)."
        },
        "municipality": {
          "type": "string",
          "description": "Local level administrative municipality or rural municipality (e.g. Pokhara Lekhnath Metropolitan City)."
        },
        "wardNumber": {
          "type": "integer",
          "description": "Ward division number (e.g. 5)."
        },
        "currentLocation": {
          "type": "object",
          "description": "Geographical coordinates for proximity matching and regional alerts.",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          },
          "required": ["latitude", "longitude"]
        },
        "skills": {
          "type": "array",
          "description": "List of vocational, safety, agricultural, or professional citizen capacities."
        },
        "interests": {
          "type": "array",
          "description": "Interests to suggest mutual volunteer opportunities and community threads."
        },
        "reputationScore": {
          "type": "integer",
          "description": "Consolidated trust score ranging from 0 to 100 based on peer assertions and active help responses."
        },
        "verificationStatus": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "description": "Citizen verification level. Level 1: Phone, Level 2: Gov ID, Level 3: Community vouched, Level 4: Trusted Elder."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended", "under_verification"],
          "description": "Operational status of the account."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of user creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the latest modifications."
        }
      },
      "required": [
        "userId",
        "fullName",
        "username",
        "phoneNumber",
        "province",
        "district",
        "municipality",
        "wardNumber",
        "reputationScore",
        "verificationStatus",
        "accountStatus",
        "createdAt"
      ]
    },
    "VerificationLevel": {
      "title": "Verification Level Log",
      "description": "A ledger tracking verified milestones for Level 1, 2, 3, and 4 status.",
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "description": "The target verification tier achieved."
        },
        "name": {
          "type": "string",
          "description": "Name of verification tier (e.g. Government ID Verified)."
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of check completion."
        },
        "method": {
          "type": "string",
          "description": "Method of verification (OTP, manual doc inspection, community polling)."
        },
        "documentType": {
          "type": "string",
          "enum": ["citizenship_card", "passport", "driving_license", "voter_card", "none"],
          "description": "Type of document submitted for verification."
        },
        "verifierId": {
          "type": "string",
          "description": "UID of verification authority or verifier citizen peer."
        }
      },
      "required": ["level", "name", "verifiedAt", "method"]
    },
    "CommunityNode": {
      "title": "Community Administrative Node",
      "description": "Hierarchical registry maps administrative units down to wards and local communities (Tole).",
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "Unique dynamic combination ID of ProvinceCode-DistrictCode-MuniCode-Ward."
        },
        "province": {
          "type": "string",
          "description": "Name of official Province."
        },
        "district": {
          "type": "string",
          "description": "Name of official District."
        },
        "municipality": {
          "type": "string",
          "description": "Name of official Municipality/Village Council."
        },
        "ward": {
          "type": "integer",
          "description": "Ward identifier."
        },
        "localCommunityName": {
          "type": "string",
          "description": "Tole or specific micro-community settlement."
        },
        "residentCount": {
          "type": "integer",
          "description": "Aggregate size of registered platform citizens within this ward boundary."
        }
      },
      "required": ["nodeId", "province", "district", "municipality", "ward", "localCommunityName", "residentCount"]
    },
    "ChatRoom": {
      "title": "Chat Room Session",
      "description": "Entity defining a distinct text/media environment setup for chat.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Unique room ID."
        },
        "type": {
          "type": "string",
          "enum": ["personal", "group", "community"],
          "description": "Classification of context: personal (1-to-1), group, or community ward scale."
        },
        "name": {
          "type": "string",
          "description": "Visual name of group/community chat."
        },
        "members": {
          "type": "array",
          "description": "Collection of verified User UIDs possessing active sync paths."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of owner/creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "type", "members", "createdBy", "createdAt"]
    },
    "Message": {
      "title": "Communication Chat Message",
      "description": "Rich chat message containing text, coordinates, attachments, or voice clips.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "senderId": {
          "type": "string",
          "description": "UID of messaging citizen."
        },
        "senderName": {
          "type": "string",
          "description": "Sender cached display name."
        },
        "text": {
          "type": "string",
          "description": "Body message text content."
        },
        "voiceMessageUrl": {
          "type": "string",
          "description": "Secure file storage URL containing AAC / WebM audio message records."
        },
        "fileAttachmentUrl": {
          "type": "string",
          "description": "Secure storage URL relating to documents, permits, or certificates."
        },
        "fileAttachmentType": {
          "type": "string",
          "description": "MIME classification of the file attachment."
        },
        "imageAttachmentUrl": {
          "type": "string",
          "description": "Secure storage URL relating to image files."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Message dispatch server time."
        }
      },
      "required": ["messageId", "senderId", "senderName", "timestamp"]
    },
    "ServiceProvider": {
      "title": "Verified Local Service Provider",
      "description": "Service registry matching skilled professionals with community hiring needs.",
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "description": "Associated user account UID."
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["plumbing", "electrical", "teaching", "health", "guide", "carpentry", "mechanic", "agricultural", "tailoring", "other"]
        },
        "phone": {
          "type": "string",
          "description": "Contact number specific to the service directory."
        },
        "serviceArea": {
          "type": "array",
          "description": "Geographical scope where operations are served (list of municipalities/districts)."
        },
        "description": {
          "type": "string"
        },
        "cost": {
          "type": "string",
          "description": "Hourly, daily, or piece-work cost description (e.g. NPR 500/day)."
        },
        "rating": {
          "type": "number",
          "description": "Continuous rating calculated from aggregate customer reviews."
        },
        "reviewsCount": {
          "type": "integer"
        },
        "isVerifiedProvider": {
          "type": "boolean",
          "description": "Local council or peer team verified flag."
        }
      },
      "required": ["providerId", "userId", "name", "category", "phone", "serviceArea", "cost", "rating", "reviewsCount", "isVerifiedProvider"]
    },
    "ServiceReview": {
      "title": "Service Review & Star Rating",
      "description": "Peer feedback records verifying citizen satisfaction.",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string"
        },
        "reviewerId": {
          "type": "string",
          "description": "UID of customer."
        },
        "reviewerName": {
          "type": "string"
        },
        "rating": {
          "type": "integer",
          "description": "Star scale validation between 1 and 5."
        },
        "comment": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reviewId", "reviewerId", "reviewerName", "rating", "comment", "createdAt"]
    },
    "MarketplaceListing": {
      "title": "Local Haat-Bazaar Marketplace Listing",
      "description": "Product or resource listings for sale, exchange, or rental inside local wards.",
      "type": "object",
      "properties": {
        "listingId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "string",
          "description": "Price descriptor with label (e.g. NPR 250/KG or NPR 1200 Exchange)."
        },
        "category": {
          "type": "string",
          "enum": ["farm", "livestock", "tools", "household", "books", "other"]
        },
        "listingType": {
          "type": "string",
          "enum": ["product_sale", "rental", "exchange"],
          "description": "Specifies transaction type (exchanges involve seed swaps, barter, or seed sharing)."
        },
        "sellerId": {
          "type": "string"
        },
        "sellerName": {
          "type": "string"
        },
        "sellerPhone": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "district": {
          "type": "string"
        },
        "municipality": {
          "type": "string"
        },
        "availabilityStatus": {
          "type": "string",
          "enum": ["available", "pending", "sold", "rented", "exchanged"],
          "description": "Availability state of item."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["listingId", "title", "description", "price", "category", "listingType", "sellerId", "sellerName", "sellerPhone", "district", "availabilityStatus", "createdAt"]
    },
    "HelpRequest": {
      "title": "Emergency & Mutual Aid Guhar Help Request",
      "description": "Life-saving emergency SOS, blood requests, missing reports, or lost-found logs.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["blood", "emergency_sos", "missing_person", "lost_and_found", "community_help"]
        },
        "urgency": {
          "type": "string",
          "enum": ["critical", "high", "normal"]
        },
        "contactName": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "district": {
          "type": "string"
        },
        "municipality": {
          "type": "string"
        },
        "ward": {
          "type": "integer"
        },
        "lookingFor": {
          "type": "string",
          "description": "Descriptions of resources, blood unit specifications (e.g. O Neg), or rescue teams requested."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Safety request status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["requestId", "title", "description", "category", "urgency", "contactName", "contactPhone", "province", "district", "municipality", "ward", "status", "createdAt"]
    },
    "JobListing": {
      "title": "Employment Opportunity",
      "description": "Daily-wage, agricultural, part-time, or full-time labor requests within the village/ward.",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "employerId": {
          "type": "string"
        },
        "employerName": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "payment": {
          "type": "string",
          "description": "Remuneration details (e.g. NPR 800/Day)."
        },
        "type": {
          "type": "string",
          "enum": ["daily", "part-time", "agricultural", "freelance", "full-time"]
        },
        "skillRequirements": {
          "type": "array",
          "description": "Required manual or technical capacities."
        },
        "province": {
          "type": "string"
        },
        "district": {
          "type": "string"
        },
        "municipality": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["jobId", "employerId", "employerName", "title", "description", "payment", "type", "skillRequirements", "district", "createdAt"]
    },
    "JobApplication": {
      "title": "Labor Application",
      "description": "Record linking local applicants to listed jobs.",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "applicantId": {
          "type": "string"
        },
        "applicantName": {
          "type": "string"
        },
        "applicantPhone": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "shortlisted", "accepted", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["applicationId", "jobId", "applicantId", "applicantName", "applicantPhone", "status", "createdAt"]
    },
    "SecurityLog": {
      "title": "User Security History Audit",
      "description": "Tamper-proof ledger logging login history, session events, device information, and sensitive actions.",
      "type": "object",
      "properties": {
        "logId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": ["login", "logout", "failed_login", "device_addition", "password_change", "id_verification_submit"]
        },
        "ipAddress": {
          "type": "string"
        },
        "deviceInfo": {
          "type": "string",
          "description": "Includes OS, browser, or hardware identifiers."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["logId", "userId", "action", "ipAddress", "deviceInfo", "timestamp"]
    },
    "UserReport": {
      "title": "Trust Violation & Abuse Report",
      "description": "Ledger tracking fraud reports, user complaints, spam, fake postings, or safety escalations.",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string"
        },
        "reporterId": {
          "type": "string"
        },
        "reportedEntityId": {
          "type": "string",
          "description": "Can represent a user UID, listing ID, service ID, or chat room ID depending on type."
        },
        "category": {
          "type": "string",
          "enum": ["login_hijack", "harassment", "marketplace_fraud", "fake_emergency_sos", "unverified_information_spam"]
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["open", "under_review", "resolved_no_action", "resolved_user_suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reportId", "reporterId", "reportedEntityId", "category", "description", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Individual registered citizen account mapping."
    },
    "/users/{userId}/verifications/{verificationId}": {
      "schema": "VerificationLevel",
      "description": "Milestone log detailing specific Government, Phone or council authentications."
    },
    "/users/{userId}/securityLogs/{logId}": {
      "schema": "SecurityLog",
      "description": "Audit trails charting logins and device interactions for security checks."
    },
    "/communities/{communityId}": {
      "schema": "CommunityNode",
      "description": "Wards and Toles demographic aggregation census registry."
    },
    "/chatRooms/{roomId}": {
      "schema": "ChatRoom",
      "description": "Communications channel connecting users in various layouts."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages dispatched containing text, voice captures, or relative files."
    },
    "/services/{providerId}": {
      "schema": "ServiceProvider",
      "description": "Local verified service directory listed under community districts."
    },
    "/services/{providerId}/reviews/{reviewId}": {
      "schema": "ServiceReview",
      "description": "Verified reviews submitted by clients."
    },
    "/marketplace/{listingId}": {
      "schema": "MarketplaceListing",
      "description": "Agricultural, household items, rentals or swaps."
    },
    "/helpRequests/{requestId}": {
      "schema": "HelpRequest",
      "description": "Emergency alert SOS logs or community mutual aid requests."
    },
    "/jobs/{jobId}": {
      "schema": "JobListing",
      "description": "Job listings requiring specialized skills."
    },
    "/jobs/{jobId}/applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Citizens applications responding to opportunities."
    },
    "/reports/{reportId}": {
      "schema": "UserReport",
      "description": "Abuse, spam, and fraud reports ledger."
    }
  }
}
